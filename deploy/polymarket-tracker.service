[Unit]
Description=Polymarket Price Tracker
After=network-online.target
Wants=network-online.target

[Service]
User=tracker
WorkingDirectory=/opt/polymarket-tracker
# bind to localhost only — Caddy reverse-proxies HTTPS to it; the port is
# not exposed to the internet directly
ExecStart=/opt/polymarket-tracker/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
