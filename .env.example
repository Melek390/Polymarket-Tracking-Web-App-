# Polymarket Price Tracker — environment config (copy to .env, never commit .env)

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database ---
DB_PATH=prices.db

# --- Collector ---
DEFAULT_POLL_INTERVAL=5        # seconds; per-market override lives in the DB
HTTP_TIMEOUT=30                # generous: throttled-but-slow responses are successes
MAX_RETRIES=5                  # exponential backoff with jitter on HTTP 429

# --- Screener ---
SCREENER_REFRESH_MINUTES=5     # how often the match cache is rebuilt
MLB_POLL_SECONDS=3            # live MLB game-state poll (feed updates every 6-8s)

# --- Polymarket public APIs (no keys needed, read-only) ---
GAMMA_BASE_URL=https://gamma-api.polymarket.com
CLOB_BASE_URL=https://clob.polymarket.com

# --- Logging ---
LOG_LEVEL=INFO

# --- Auth (added Aug 2026; the public URL used to be wide open) ---
AUTH_ENABLED=true              # MUST stay true on the server
AUTH_COOKIE_SECURE=true        # true behind HTTPS; false for http://localhost
AUTH_SESSION_DAYS=30           # how long a signed-in browser stays signed in
AUTH_INVITE_DAYS=7             # invitation link lifetime
AUTH_RESET_HOURS=4             # password-reset link lifetime
# scripts/healthcheck.py has no browser and so no cookie; it sends this in
# X-Health-Token to read the API. Generate a long random value per install:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = the bypass does not exist and the healthcheck cannot run.
AUTH_HEALTH_TOKEN=
